{
  "version": 2,
  "buildCommand": "vite build",
  "devCommand": "tsx server.ts",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(api|auth)(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
