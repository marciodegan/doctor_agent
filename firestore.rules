rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Basic helpers
    function isSignedIn() {
      return request.auth != null;
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isValidId(id) {
       return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isMember(groupId) {
      let memberDoc = /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid);
      let groupDoc = /databases/$(database)/documents/groups/$(groupId);
      return isSignedIn() && (
        (exists(memberDoc) && (get(memberDoc).data.status == "active" || get(memberDoc).data.status == "conectado")) ||
        (exists(groupDoc) && get(groupDoc).data.createdBy == request.auth.uid)
      );
    }
    
    function isOwner(groupId) {
      let memberDoc = /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid);
      let groupDoc = /databases/$(database)/documents/groups/$(groupId);
      return isSignedIn() && (
        (exists(groupDoc) && get(groupDoc).data.createdBy == request.auth.uid) ||
        (exists(memberDoc) && 
         (get(memberDoc).data.role == "owner" || get(memberDoc).data.role == "admin") &&
         (get(memberDoc).data.status == "active" || get(memberDoc).data.status == "conectado"))
      );
    }

    // Entity Validations
    function isValidShoppingItem(data) {
      return data.keys().hasAll(['name', 'checked']) &&
             data.name is string && data.name.size() <= 100 &&
             data.checked is bool &&
             (data.get('updatedBy', null) == null || data.updatedBy == request.auth.uid) &&
             (data.get('addedBy', null) == null || data.addedBy is string);
    }

    // Global app configuration
    match /app_config/{configId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
      
      match /memberships/{groupId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if isSignedIn() && request.auth.uid == userId;
      }

      match /private/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // User personal notes
    match /user_notes/{noteId} {
      allow read: if isSignedIn() && 
                    resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && 
                       incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && 
                       existing().userId == request.auth.uid && 
                       incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && 
                       existing().userId == request.auth.uid;
    }

    // Groups
    match /groups/{groupId} {
      allow get: if isMember(groupId);
      allow list: if isSignedIn() && resource.data.createdBy == request.auth.uid; 
      allow create: if isSignedIn() && incoming().createdBy == request.auth.uid;
      allow update: if isOwner(groupId); 
      
      match /members/{memberId} {
        allow read: if isMember(groupId) || 
                      (isSignedIn() && request.auth.uid == memberId);
        // Allow a user to create or update their own membership document when joining as a member
        allow create: if isSignedIn() && (
          isOwner(groupId) ||
          (request.auth.uid == memberId && 
           incoming().get('role', 'member') == "member" && 
           (incoming().status == "conectado" || incoming().status == "pending" || incoming().status == "active"))
        );
        allow update: if isOwner(groupId) || (
          isSignedIn() && 
          request.auth.uid == memberId && 
          incoming().get('role', 'member') == "member" &&
          (incoming().status == "active" || incoming().status == "conectado" || incoming().status == "declined" || incoming().status == "cancelled" || incoming().status == "pending")
        );
        allow delete: if isOwner(groupId);
      }
      
      match /calendario/{eventId} {
        allow read, write: if isMember(groupId);
      }

      match /shopping_list/{itemId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId) && isValidShoppingItem(incoming()) && isValidId(itemId);
        allow update: if isMember(groupId) && isValidShoppingItem(incoming());
        allow delete: if isMember(groupId);
      }
    }

    // Group Invitations
    match /group_invitations/{invId} {
      allow read: if isSignedIn() && request.auth.token.email == existing().email;
      allow create: if isOwner(incoming().groupId);
      allow update: if (isSignedIn() && request.auth.token.email == existing().email && (incoming().status == "accepted" || incoming().status == "declined")) ||
                      isOwner(existing().groupId);
      allow delete: if isOwner(existing().groupId);
    }

    // Procedure Options (scoped by group)
    match /procedureOptions/{optionId} {
      allow read: if isMember(resource.data.groupId);
      allow create: if isOwner(request.resource.data.groupId);
      allow update: if isOwner(resource.data.groupId) && isOwner(request.resource.data.groupId);
      allow delete: if isOwner(resource.data.groupId);
    }

    // Config entities linked by groupId
    match /patient_statuses/{statusId} {
      allow read: if isMember(resource.data.groupId);
      allow create: if isOwner(request.resource.data.groupId);
      allow update: if isOwner(resource.data.groupId) && isOwner(request.resource.data.groupId);
      allow delete: if isOwner(resource.data.groupId);
    }

    match /affinity/{affinityId} {
      allow read: if isMember(resource.data.groupId);
      allow create: if isOwner(request.resource.data.groupId);
      allow update: if isOwner(resource.data.groupId) && isOwner(request.resource.data.groupId);
      allow delete: if isOwner(resource.data.groupId);
    }

    match /surgery_types/{typeId} {
      allow read: if isMember(resource.data.groupId);
      allow create: if isOwner(request.resource.data.groupId);
      allow update: if isOwner(resource.data.groupId) && isOwner(request.resource.data.groupId);
      allow delete: if isOwner(resource.data.groupId);
    }

    match /document_categories/{catId} {
      allow read: if isMember(resource.data.groupId);
      allow create: if isOwner(request.resource.data.groupId);
      allow update: if isOwner(resource.data.groupId) && isOwner(request.resource.data.groupId);
      allow delete: if isOwner(resource.data.groupId);
    }

    match /image_types/{typeId} {
      allow read: if isMember(resource.data.groupId);
      allow create: if isOwner(request.resource.data.groupId);
      allow update: if isOwner(resource.data.groupId) && isOwner(request.resource.data.groupId);
      allow delete: if isOwner(resource.data.groupId);
    }

    // Entities linked by groupId
    match /patients/{patientId} {
      allow read: if isMember(existing().groupId);
      allow create: if isMember(incoming().groupId);
      allow update: if isMember(existing().groupId) && isMember(incoming().groupId);
      allow delete: if isMember(existing().groupId);
    }

    match /hospitals/{hospitalId} {
      allow read: if isMember(existing().groupId);
      allow create: if isOwner(incoming().groupId);
      allow update: if isOwner(existing().groupId) && isOwner(incoming().groupId);
      allow delete: if isOwner(existing().groupId);
    }

    match /settings/{settingId} {
      allow read: if isMember(existing().groupId);
      allow create: if isOwner(incoming().groupId);
      allow update: if isOwner(existing().groupId) && isOwner(incoming().groupId);
    }

    // Sub-entities related to patients (relational sync)
    function canAccessPatient(patientId) {
      return isMember(get(/databases/$(database)/documents/patients/$(patientId)).data.groupId);
    }

    match /family_members/{memberId} {
      allow read, write: if isSignedIn() && (
        (resource != null && canAccessPatient(existing().patientId)) ||
        (request.resource != null && canAccessPatient(incoming().patientId))
      );
    }

    match /patients_contacts/{contactId} {
      allow read, write: if isSignedIn() && (
        (resource != null && canAccessPatient(existing().patientId)) ||
        (request.resource != null && canAccessPatient(incoming().patientId))
      );
    }

    match /patient_logs/{logId} {
      allow read, write: if isSignedIn() && (
        (resource != null && canAccessPatient(existing().patientId)) ||
        (request.resource != null && canAccessPatient(incoming().patientId))
      );
    }

    match /files/{fileId} {
      allow read: if isSignedIn() && (
        isMember(resource.data.groupId) || 
        (resource.data.patientId != null && canAccessPatient(resource.data.patientId))
      );
      allow create: if isSignedIn() && (
        isMember(incoming().groupId) || 
        (incoming().patientId != null && canAccessPatient(incoming().patientId))
      );
      allow update: if isSignedIn() && (
        isMember(existing().groupId) && isMember(incoming().groupId)
      );
      allow delete: if isSignedIn() && isMember(existing().groupId);
    }

    match /procedimentos/{procedimentoId} {
      allow read: if isSignedIn() && (
        (resource != null && resource.data.groupId != null && isMember(resource.data.groupId)) ||
        (resource != null && resource.data.pacienteId != null && canAccessPatient(resource.data.pacienteId))
      );
      allow create: if isSignedIn() && (
        (incoming().groupId != null && isMember(incoming().groupId)) ||
        (incoming().pacienteId != null && canAccessPatient(incoming().pacienteId))
      );
      allow update: if isSignedIn() && (
        (existing().groupId != null && isMember(existing().groupId) && incoming().groupId != null && isMember(incoming().groupId)) ||
        (existing().pacienteId != null && canAccessPatient(existing().pacienteId))
      );
      allow delete: if isSignedIn() && (
        (existing().groupId != null && isOwner(existing().groupId)) ||
        (existing().pacienteId != null && canAccessPatient(existing().pacienteId))
      );
    }
  }
}
