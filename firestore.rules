rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Main entities
    match /patients/{patientId} {
      allow read, write: if isSignedIn();
    }

    match /groups/{groupId}/calendario/{eventId} {
      allow read, write: if isSignedIn();
    }

    match /hospitals/{hospitalId} {
      allow read, write: if isSignedIn();
    }

    match /patient_statuses/{statusId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /logs/{logId} {
      allow read, write: if isSignedIn();
    }

    match /family_members/{memberId} {
      allow read, write: if isSignedIn();
    }

    match /patients_contacts/{contactId} {
      allow read, write: if isSignedIn();
    }

    match /patient_logs/{logId} {
      allow read, write: if isSignedIn();
    }

    match /files/{fileId} {
      allow read, write: if isSignedIn();
    }

    match /settings/{settingId} {
      allow read, write: if isSignedIn();
    }

    match /status_history/{historyId} {
      allow read, write: if isSignedIn();
    }
    
    match /activities/{activityId} {
      allow read, write: if isSignedIn();
    }
    
    match /image_options/{optionId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
