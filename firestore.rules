rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Basic helpers
    function isSignedIn() {
      return request.auth != null;
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isMember(groupId) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == "active";
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || resource.data.email == request.auth.token.email);
      allow list: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
      
      match /memberships/{groupId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if isSignedIn() && (
          request.auth.uid == userId || 
          isMember(groupId) // Allow existing members to add group to someone else
        );
      }
    }

    // Groups
    match /groups/{groupId} {
      allow get: if isMember(groupId) || 
                   (isSignedIn() && existing().createdBy == request.auth.uid) ||
                   exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
      allow list: if isSignedIn(); 
      allow create: if isSignedIn() && incoming().createdBy == request.auth.uid;
      allow update: if isMember(groupId) || (isSignedIn() && existing().createdBy == request.auth.uid); 
      
      match /members/{memberId} {
        allow read: if isMember(groupId) || 
                      (isSignedIn() && (
                        request.auth.uid == memberId ||
                        get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
                      ));
        allow create: if isSignedIn() && (
          request.auth.uid == memberId || 
          isMember(groupId) || 
          get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
        );
        allow update: if (isSignedIn() && request.auth.uid == memberId && (incoming().status == "active" || incoming().status == "cancelled")) || 
                        isMember(groupId) || 
                        (isSignedIn() && get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid);
        allow delete: if isMember(groupId) || (isSignedIn() && get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid);
      }
      
      match /calendario/{eventId} {
        allow read, write: if isMember(groupId);
      }
    }

    // Group Invitations
    match /group_invitations/{invId} {
      allow read: if isSignedIn() && request.auth.token.email == existing().email;
      allow create: if isMember(incoming().groupId);
      allow update: if (isSignedIn() && request.auth.token.email == existing().email && (incoming().status == "accepted" || incoming().status == "declined")) ||
                      isMember(existing().groupId);
      allow delete: if isMember(existing().groupId);
    }

    // Procedure Options
    match /procedureOptions/{optionId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Entities linked by groupId
    match /patients/{patientId} {
      allow read: if isMember(existing().groupId);
      allow create: if isMember(incoming().groupId);
      allow update: if isMember(existing().groupId) && isMember(incoming().groupId);
      allow delete: if isMember(existing().groupId);
    }

    match /hospitals/{hospitalId} {
      allow read: if isMember(existing().groupId);
      allow create: if isMember(incoming().groupId);
      allow update: if isMember(existing().groupId) && isMember(incoming().groupId);
      allow delete: if isMember(existing().groupId);
    }

    match /settings/{settingId} {
      allow read: if isMember(existing().groupId);
      allow create: if isMember(incoming().groupId);
      allow update: if isMember(existing().groupId) && isMember(incoming().groupId);
    }

    // Sub-entities related to patients (relational sync)
    function canAccessPatient(patientId) {
      return isMember(get(/databases/$(database)/documents/patients/$(patientId)).data.groupId);
    }

    match /family_members/{memberId} {
      allow read, write: if isSignedIn() && (
        (resource != null && canAccessPatient(existing().patientId)) ||
        (request.resource != null && canAccessPatient(incoming().patientId))
      );
    }

    match /patients_contacts/{contactId} {
      allow read, write: if isSignedIn() && (
        (resource != null && canAccessPatient(existing().patientId)) ||
        (request.resource != null && canAccessPatient(incoming().patientId))
      );
    }

    match /patient_logs/{logId} {
      allow read, write: if isSignedIn() && (
        (resource != null && canAccessPatient(existing().patientId)) ||
        (request.resource != null && canAccessPatient(incoming().patientId))
      );
    }

    match /files/{fileId} {
      allow read, write: if isSignedIn() && (
        (resource != null && canAccessPatient(existing().patientId)) ||
        (request.resource != null && canAccessPatient(incoming().patientId))
      );
    }
  }
}
