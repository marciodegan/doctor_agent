{
  "entities": {
    "Group": {
      "title": "Group",
      "description": "Collaborative group sharing patients and calendar",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "imageAnalysisPrompt": { "type": "string" }
      },
      "required": ["id", "name", "createdBy"]
    },
    "GroupMember": {
      "title": "Group Member",
      "description": "User membership in a group",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "whatsapp": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "member"] },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "role"]
    },
    "Hospital": {
      "title": "Hospital",
      "description": "Information about a hospital",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "groupId": { "type": "string" },
        "active": { "type": "boolean" },
        "phone": { "type": "string" },
        "contacts": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "name"]
    },
    "PatientStatus": {
      "title": "Patient Status",
      "description": "Available statuses for patients (scoped per group)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "groupId": { "type": "string" },
        "active": { "type": "boolean" },
        "sortOrder": { "type": "integer" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "groupId"]
    },
    "Patient": {
      "title": "Patient",
      "description": "Patient basic information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "groupId": { "type": "string" },
        "phone": { "type": "string" },
        "age": { "type": "string" },
        "statusId": { "type": "string" },
        "hospitalId": { "type": "string" },
        "roomNumber": { "type": "string" },
        "cpf": { "type": "string" },
        "procedure": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name"]
    },
    "Log": {
      "title": "Status Log",
      "description": "Status update log for a patient",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "File": {
      "title": "Patient File",
      "description": "Images or documents linked to a patient",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "patientId": { "type": "string" },
        "description": { "type": "string" },
        "link": { "type": "string" },
        "aiAnalysis": { "type": "string" }
      }
    },
    "FamilyMember": {
      "title": "Family Member",
      "description": "Contact information for a patient's relative",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "relationship": { "type": "string" },
        "phone": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" }
      }
    },
    "PatientContact": {
      "title": "Patient Contact",
      "description": "Contact information for a patient relative or associate",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "relationship": { "type": "string" },
        "phone": { "type": "string" },
        "patientId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "patientId"]
    },
    "PatientLog": {
      "title": "Patient Log",
      "description": "Clinical log or observation for a patient",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "text": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "audio"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "patientId", "text"]
    },
    "Setting": {
      "title": "App Setting",
      "description": "Configuration values",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "value": { "type": "string" },
        "groupId": { "type": "string" }
      }
    },
    "CalendarEvent": {
      "title": "Calendar Event",
      "description": "Surgery or procedure scheduled in the shared group calendar",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nomePaciente": { "type": "string", "description": "Nome do paciente" },
        "evento": { "type": "string" },
        "data": { "type": "string", "description": "YYYY-MM-DD" },
        "hora": { "type": "string", "description": "HH:mm" },
        "descricao": { "type": "string" },
        "tipo": { "type": "string", "enum": ["ELETIVA", "URGÊNCIA"], "description": "Categoria do evento" },
        "sala": { "type": "string", "enum": ["SALA 1", "SALA 2"] },
        "groupId": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["evento", "data", "hora", "groupId", "createdBy"]
    },
    "ImageType": {
      "title": "Tipo de Imagem",
      "description": "Categorias de anexos de imagem (scoped per group)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "groupId": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "groupId"]
    },
    "DoctorProviderMapping": {
      "title": "Doctor Provider Mapping",
      "description": "Mapping configuration between Executante, Prestador, and Doctor",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teamId": { "type": "string" },
        "doctorId": { "type": "string" },
        "doctorName": { "type": "string" },
        "executante": { "type": "string" },
        "prestador": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "teamId", "doctorId", "doctorName", "executante", "prestador", "active"]
    },
    "User": {
      "title": "User",
      "description": "Application user profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "whatsapp": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "doctor", "staff"] }
      }
    },
    "ProcedureOption": {
      "title": "Opção de Procedimento",
      "description": "Opção predefinida para o campo de evento/procedimento (scoped per group)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "groupId": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nome", "groupId"]
    },
    "SurgeryType": {
      "title": "Tipo de Cirurgia",
      "description": "Urgente, Eletiva, etc (scoped per group)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "groupId": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["name", "groupId"]
    },
    "Affinity": {
      "title": "Afinidade",
      "description": "Grau de parentesco (scoped per group)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "groupId": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["name", "groupId"]
    },
    "ShoppingItem": {
      "title": "Shopping Item",
      "description": "Item in a shared shopping list",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "checked": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" },
        "addedBy": { "type": "string" }
      },
      "required": ["id", "name", "checked"]
    },
    "Note": {
      "title": "Personal Note",
      "description": "User specific quick note",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "content"]
    },
    "AppConfig": {
      "title": "Configuração do App",
      "description": "Configurações globais do sistema",
      "type": "object",
      "properties": {
        "latestVersion": { "type": "string" },
        "forceUpdate": { "type": "boolean" },
        "message": { "type": "string" }
      },
      "required": ["latestVersion"]
    },
    "Procedimento": {
      "title": "Procedimento",
      "description": "Ocorrência de procedimento médico importada do CSV e vinculada ao paciente",
      "type": "object",
      "properties": {
        "pacienteId": { "type": "string" },
        "codigoUsuario": { "type": "string" },
        "nomeUsuario": { "type": "string" },
        "groupId": { "type": "string" },
        "periodo": { "type": "string" },
        "notaFiscal": { "type": "string" },
        "relacaoNr": { "type": "string" },
        "data": { "type": "string" },
        "documento": { "type": "string" },
        "quantidade": { "type": "number" },
        "codigoAMB": { "type": "string" },
        "descricao": { "type": "string" },
        "valorHonorarios": { "type": "number" },
        "valorOperacional": { "type": "number" },
        "valorFilme": { "type": "number" },
        "valorTaxaAdministrativa": { "type": "number" },
        "prestadorExecutante": { "type": "string" },
        "prestadorPagamento": { "type": "string" },
        "prestadorProtocolo": { "type": "string" },
        "dadosOriginais": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["pacienteId", "codigoUsuario", "codigoAMB"]
    },
    "FinancialClosing": {
      "title": "Financial Closing",
      "description": "Financial closing period (e.g. SETEMBRO-26)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "competencia": { "type": "string" },
        "mes": { "type": "integer" },
        "ano": { "type": "integer" },
        "status": { "type": "string", "enum": ["ABERTO", "EM_CONFERENCIA", "FECHADO"] },
        "dataCriacao": { "type": "string" },
        "dataFechamento": { "type": "string" },
        "observacao": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "nome", "status"]
    },
    "FinancialTransaction": {
      "title": "Financial Transaction",
      "description": "Financial transaction entry from PDF, CSV or manual input",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teamId": { "type": "string" },
        "doctorId": { "type": "string" },
        "doctorName": { "type": "string" },
        "tipoLancamentoId": { "type": "string" },
        "tipoLancamentoNome": { "type": "string" },
        "dataLancamento": { "type": "string" },
        "valor": { "type": "number" },
        "natureza": { "type": "string", "enum": ["CREDITO", "DEBITO"] },
        "observacao": { "type": "string" },
        "fechamentoId": { "type": "string" },
        "fechamentoNome": { "type": "string" },
        "origem": { "type": "string" },
        "origemArquivo": { "type": "string" },
        "loteImportacaoId": { "type": "string" },
        "criadoManualmente": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "teamId", "doctorName", "valor", "natureza"]
    },
    "FinancialTransactionType": {
      "title": "Financial Transaction Type",
      "description": "Types of financial transactions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "categoria": { "type": "string" },
        "naturezaPadrao": { "type": "string" },
        "ativo": { "type": "boolean" },
        "ordem": { "type": "integer" }
      },
      "required": ["id", "nome"]
    },
    "FinancialImport": {
      "title": "Financial Import",
      "description": "Record of financial document imports",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teamId": { "type": "string" },
        "tipoArquivo": { "type": "string" },
        "nomeArquivo": { "type": "string" },
        "fechamentoId": { "type": "string" },
        "fechamentoNome": { "type": "string" },
        "quantidadeLancamentos": { "type": "integer" },
        "valorTotalCreditos": { "type": "number" },
        "valorTotalDebitos": { "type": "number" },
        "valorTotal": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "teamId", "nomeArquivo", "status"]
    }
  },
  "firestore": {
    "/financial_closings/{closingId}": {
      "schema": "FinancialClosing",
      "description": "Financial closing periods"
    },
    "/financial_transactions/{transactionId}": {
      "schema": "FinancialTransaction",
      "description": "Financial transactions"
    },
    "/financial_transaction_types/{typeId}": {
      "schema": "FinancialTransactionType",
      "description": "Financial transaction types"
    },
    "/financial_imports/{importId}": {
      "schema": "FinancialImport",
      "description": "Financial import history"
    },
    "/procedimentos/{procedimentoId}": {
      "schema": "Procedimento",
      "description": "Collection de procedimentos médicos importados do CSV"
    },
    "/app_config/{configId}": {
      "schema": "AppConfig",
      "description": "Global application configuration documents"
    },
    "/user_notes/{noteId}": {
      "schema": "Note",
      "description": "Personal user notes"
    },
    "/groups/{groupId}": {
      "schema": "Group",
      "description": "Collaborative groups"
    },
    "/groups/{groupId}/members/{memberId}": {
      "schema": "GroupMember",
      "description": "Group members and roles"
    },
    "/groups/{groupId}/shopping_list/{itemId}": {
      "schema": "ShoppingItem",
      "description": "Shared shopping list items"
    },
    "/procedureOptions/{optionId}": {
      "schema": "ProcedureOption",
      "description": "Lista de procedimentos cirúrgicos frequentes"
    },
    "/hospitals/{hospitalId}": {
      "schema": "Hospital",
      "description": "List of hospitals"
    },
    "/patient_statuses/{statusId}": {
      "schema": "PatientStatus",
      "description": "Available status options"
    },
    "/patients/{patientId}": {
      "schema": "Patient",
      "description": "Patient registry"
    },
    "/logs/{logId}": {
      "schema": "Log",
      "description": "Activity logs for patients"
    },
    "/files/{fileId}": {
      "schema": "File",
      "description": "Uploaded files and AI analysis"
    },
    "/family_members/{memberId}": {
      "schema": "FamilyMember",
      "description": "Patient family contacts"
    },
    "/patients_contacts/{contactId}": {
      "schema": "PatientContact",
      "description": "Patient family and associate contacts"
    },
    "/patient_logs/{logId}": {
      "schema": "PatientLog",
      "description": "Clinical logs and observations"
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "App configuration"
    },
    "/groups/{groupId}/calendario/{eventId}": {
      "schema": "CalendarEvent",
      "description": "Shared group calendar events"
    },
    "/affinity/{affinityId}": {
      "schema": "Affinity",
      "description": "Affinities defined by group"
    },
    "/surgery_types/{typeId}": {
      "schema": "SurgeryType",
      "description": "Surgery types defined by group"
    },
    "/image_types/{typeId}": {
      "schema": "ImageType",
      "description": "Categorias de anexos de imagem"
    },
    "/doctor_provider_mappings/{mappingId}": {
      "schema": "DoctorProviderMapping",
      "description": "Mapping configuration between Executante, Prestador, and Doctor"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Registered users"
    }
  }
}
